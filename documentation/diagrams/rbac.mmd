flowchart TD
    REQ["Protected operation<br/>role, table, operation, owner"] --> DENY{"Explicit denial?"}
    DENY -- Yes --> BLOCK["Deny with reason"]
    DENY -- No --> DIRECT{"Operation granted<br/>directly?"}
    DIRECT -- Yes --> ALLOW["Allow"]
    DIRECT -- No --> OWN{"Operation granted<br/>for own row?"}
    OWN -- Yes --> MATCH{"user_id equals<br/>target_id?"}
    MATCH -- Yes --> ALLOW
    MATCH -- No --> BLOCK
    OWN -- No --> PUBLIC{"Public projection?"}
    PUBLIC -- Yes --> ALLOW
    PUBLIC -- No --> BLOCK

